---
import type { HomePageContent } from '../../content/types';

interface Props {
  content: HomePageContent['footer'];
}

const { content } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__grid">
    <div class="site-footer__intro">
      <a class="brand-lockup brand-lockup--footer" href="#inicio">
        <span class="brand-lockup__mark" aria-hidden="true">{content.monogram}</span>
        <span class="brand-lockup__text">
          <strong>{content.brand}</strong>
          <small>{content.tagline}</small>
        </span>
      </a>
      <p>{content.description}</p>
    </div>
    <nav aria-label={content.navigationLabel}>
      <p class="site-footer__title">{content.navigationTitle}</p>
      <ul>
        {content.links.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </nav>
    <div>
      <p class="site-footer__title">{content.serviceTitle}</p>
      <ul>
        {content.serviceLines.map((line) => <li>{line}</li>)}
      </ul>
    </div>
  </div>
  <div class="container site-footer__bottom">
    <p>© {currentYear} {content.copyright}</p>
    <p>{content.closingLine}</p>
  </div>
</footer>
