---
import type { HomePageContent } from '../../content/types';

interface Props {
  content: HomePageContent['header'];
}

const { content } = Astro.props;
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand-lockup" href="#inicio" aria-label={`${content.brand}, início`}>
      <span class="brand-lockup__mark" aria-hidden="true">{content.monogram}</span>
      <span class="brand-lockup__text">
        <strong>{content.brand}</strong>
        <small>{content.tagline}</small>
      </span>
    </a>
    <nav class="site-header__nav site-header__nav--desktop" aria-label={content.navigationLabel}>
      <ul>
        {content.links.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </nav>
    <details class="site-header__menu">
      <summary aria-label={content.menuLabel}>
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </summary>
      <nav aria-label={content.navigationLabel}>
        <ul>
          {content.links.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </nav>
    </details>
  </div>
</header>
