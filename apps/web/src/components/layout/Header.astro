---
import Button from '../ui/Button.astro';
import type { HomePageContent } from '../../content/types';

interface Props {
  content: HomePageContent['header'];
}

const { content } = Astro.props;
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__brand" href="#inicio" aria-label={`${content.brand}, início`}>
      {content.brand}
    </a>
    <nav class="site-header__nav" aria-label={content.navigationLabel}>
      <ul>
        {content.links.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </nav>
    <Button {...content.action} variant="secondary" class="site-header__action" />
  </div>
</header>
