---
import '../../styles/product-card.css';
import type { ProductContent } from '../../content/types';

interface Props {
  product: ProductContent;
}

const { product } = Astro.props;
const imageFocus = product.image.focusPosition ?? { x: 50, y: 50 };
---

<article class="product-card" data-product-card>
  <div
    class="product-card__media"
    style={`--product-image-position: ${imageFocus.x}% ${imageFocus.y}%;`}
  >
    <span class="product-card__badge">{product.badge}</span>
    <img
      src={product.image.src}
      alt={product.image.alt}
      width={product.image.width}
      height={product.image.height}
      loading="lazy"
      decoding="async"
    />

    {product.details.map((detail, index) => {
      const panelId = `${product.id}-${detail.id}-panel`;
      return (
        <button
          class="product-card__hotspot"
          type="button"
          style={`--hotspot-x: ${detail.position.x}%; --hotspot-y: ${detail.position.y}%;`}
          aria-label={`Ver detalhes: ${detail.name}`}
          aria-expanded="false"
          aria-controls={panelId}
          data-product-hotspot
          data-target={panelId}
        >
          <span aria-hidden="true">+</span>
          <span class="sr-only">Detalhe {index + 1}</span>
        </button>
      );
    })}

    {product.details.map((detail) => {
      const panelId = `${product.id}-${detail.id}-panel`;
      return (
        <article
          class="product-card__detail"
          id={panelId}
          data-product-detail
          hidden
        >
          <button class="product-card__detail-close" type="button" aria-label={`Fechar detalhes de ${detail.name}`} data-product-detail-close>
            <span aria-hidden="true">×</span>
          </button>
          <p class="product-card__detail-category">{detail.category}</p>
          <h4>{detail.name}</h4>
          <p>{detail.priceLabel}</p>
        </article>
      );
    })}
  </div>

  <div class="product-card__content">
    <p class="product-card__category">{product.category}</p>
    <h3>{product.name}</h3>
    <p class="product-card__description">{product.description}</p>
    <a
      class="text-link"
      href={product.link.href}
      target={product.link.external ? '_blank' : undefined}
      rel={product.link.external ? 'noopener noreferrer' : undefined}
    >
      {product.link.label}
      <span aria-hidden="true"> →</span>
      {product.link.external && <span class="sr-only"> (abre em uma nova aba)</span>}
    </a>
  </div>
</article>

<script>
  document.querySelectorAll<HTMLElement>('[data-product-card]').forEach((card) => {
    const media = card.querySelector<HTMLElement>('.product-card__media');
    const hotspots = Array.from(card.querySelectorAll<HTMLButtonElement>('[data-product-hotspot]'));
    const panels = Array.from(card.querySelectorAll<HTMLElement>('[data-product-detail]'));

    const clamp = (value: number, min: number, max: number) =>
      Math.min(Math.max(value, min), Math.max(min, max));

    const positionDetail = (hotspot: HTMLButtonElement, panel: HTMLElement) => {
      if (!media) return;

      const inset = 16;
      const gap = 14;
      const mediaWidth = media.clientWidth;
      const mediaHeight = media.clientHeight;
      const panelWidth = Math.min(288, Math.max(0, mediaWidth - inset * 2));

      panel.style.width = `${panelWidth}px`;
      panel.style.maxHeight = `${Math.max(0, mediaHeight - inset * 2)}px`;
      panel.style.overflowY = 'auto';
      panel.style.right = 'auto';
      panel.style.transform = 'none';

      const mediaRect = media.getBoundingClientRect();
      const hotspotRect = hotspot.getBoundingClientRect();
      const panelRect = panel.getBoundingClientRect();

      const hotspotCenterX = hotspotRect.left - mediaRect.left + hotspotRect.width / 2;
      const hotspotTop = hotspotRect.top - mediaRect.top;
      const hotspotBottom = hotspotRect.bottom - mediaRect.top;
      const panelHeight = panelRect.height;

      const spaceAbove = hotspotTop - gap - inset;
      const spaceBelow = mediaHeight - hotspotBottom - gap - inset;

      let top = spaceBelow >= panelHeight || spaceBelow >= spaceAbove
        ? hotspotBottom + gap
        : hotspotTop - gap - panelHeight;

      top = clamp(top, inset, mediaHeight - panelHeight - inset);

      const left = clamp(
        hotspotCenterX - panelWidth / 2,
        inset,
        mediaWidth - panelWidth - inset,
      );

      panel.style.top = `${top}px`;
      panel.style.left = `${left}px`;
    };

    const closeDetails = (returnFocus = false) => {
      const activeHotspot = hotspots.find((hotspot) => hotspot.getAttribute('aria-expanded') === 'true');
      hotspots.forEach((hotspot) => hotspot.setAttribute('aria-expanded', 'false'));
      panels.forEach((panel) => { panel.hidden = true; });
      if (returnFocus) activeHotspot?.focus();
    };

    const repositionOpenDetail = () => {
      const activeHotspot = hotspots.find((hotspot) => hotspot.getAttribute('aria-expanded') === 'true');
      if (!activeHotspot) return;

      const panel = card.querySelector<HTMLElement>(`#${activeHotspot.dataset.target}`);
      if (panel && !panel.hidden) positionDetail(activeHotspot, panel);
    };

    hotspots.forEach((hotspot) => {
      hotspot.addEventListener('click', () => {
        const wasOpen = hotspot.getAttribute('aria-expanded') === 'true';
        const panel = card.querySelector<HTMLElement>(`#${hotspot.dataset.target}`);
        closeDetails();
        if (wasOpen || !panel) return;

        hotspot.setAttribute('aria-expanded', 'true');
        panel.hidden = false;
        positionDetail(hotspot, panel);
      });
    });

    card.querySelectorAll<HTMLButtonElement>('[data-product-detail-close]').forEach((button) =>
      button.addEventListener('click', () => closeDetails(true)),
    );

    document.addEventListener('click', (event) => {
      if (event.target instanceof Node && !card.contains(event.target)) closeDetails();
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closeDetails(true);
    });

    window.addEventListener('resize', repositionOpenDetail);
  });
</script>
