---
interface Props {
  label: string;
  href: string;
}

const { label, href } = Astro.props;
---

<a
  class="whatsapp-button"
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={`${label} (abre em uma nova aba)`}
>
  <span class="whatsapp-button__mark" aria-hidden="true">
    <img src="/icons/whatsapp.svg" alt="" width="28" height="28" />
  </span>
</a>
