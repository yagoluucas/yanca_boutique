---
import type { ClosingEditorialContent } from '../../content/types';

interface Props {
  content: ClosingEditorialContent;
}

const { content } = Astro.props;
---

<section class="closing-editorial section" id={content.id} aria-label={content.title}>
  <div class="container">
    <img
      src={content.image.src}
      alt={content.image.alt}
      width={content.image.width}
      height={content.image.height}
      loading="lazy"
      decoding="async"
    />
  </div>
</section>
