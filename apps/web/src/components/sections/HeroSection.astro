---
import Button from '../ui/Button.astro';
import type { HomePageContent } from '../../content/types';

interface Props {
  content: HomePageContent['hero'];
}

const { content } = Astro.props;
const imageFocus = content.image.focusPosition ?? { x: 50, y: 50 };
---

<section class="hero" id="inicio" aria-labelledby="hero-title">
  <div class="hero__media" aria-hidden="true">
    <img
      src={content.image.src}
      alt=""
      width={content.image.width}
      height={content.image.height}
      style={`object-position: ${imageFocus.x}% ${imageFocus.y}%;`}
    />
  </div>
  <div class="container hero__content">
    <div class="hero__panel">
      {content.eyebrow && <p class="eyebrow">{content.eyebrow}</p>}
      <h1 id="hero-title">{content.title}</h1>
      {content.description && <p class="hero__description">{content.description}</p>}
      <div class="button-group">
        <Button {...content.primaryAction} />
        <Button {...content.secondaryAction} variant="secondary" />
      </div>
    </div>
  </div>
</section>
