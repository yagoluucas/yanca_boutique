---
import type { EditorialContent } from '../../content/types';

interface Props {
  content: EditorialContent;
}

const { content } = Astro.props;
const headingId = `${content.id}-title`;
---

<section class="editorial section" id={content.id} aria-labelledby={headingId}>
  <div class="container">
    <div class="editorial__intro">
      <div>
        {content.eyebrow && <p class="eyebrow">{content.eyebrow}</p>}
        <h2 id={headingId}>{content.title}</h2>
      </div>
      {content.description && <p class="editorial__instruction">{content.description}</p>}
    </div>

    <div class="editorial__looks">
      {content.looks.map((look) => (
        <article class="editorial__look" data-shop-look aria-label="Look editorial comprável">
          <div class="editorial__media">
            <img src={look.image.src} alt={look.image.alt} width={look.image.width} height={look.image.height} loading="lazy" decoding="async" />

            {look.items.map((item, index) => {
              const panelId = `${content.id}-${look.id}-${item.id}-panel`;
              return <button class="editorial__hotspot" type="button" style={`--hotspot-x: ${item.position.x}%; --hotspot-y: ${item.position.y}%;`} aria-label={`Conhecer ${item.name}`} aria-expanded="false" aria-controls={panelId} data-hotspot data-target={panelId}><span aria-hidden="true">{index + 1}</span></button>;
            })}

            {look.items.map((item) => {
              const panelId = `${content.id}-${look.id}-${item.id}-panel`;
              return (
                <article class:list={['editorial__product', `editorial__product--${item.panelPosition ?? 'right'}`]} id={panelId} style={`--product-x: ${item.position.x}%; --product-y: ${item.position.y}%;`} data-product-panel hidden>
                  <button class="editorial__close" type="button" aria-label={`Fechar detalhes de ${item.name}`} data-product-close><span aria-hidden="true">×</span></button>
                  <p class="editorial__product-category">{item.category}</p>
                  <h3>{item.name}</h3>
                  <p class="editorial__product-price">{item.priceLabel}</p>
                  <a class="button button--primary editorial__product-action" href={item.link.href} target={item.link.external ? '_blank' : undefined} rel={item.link.external ? 'noopener noreferrer' : undefined}>
                    {item.link.label}
                    {item.link.external && <span class="sr-only"> (abre em uma nova aba)</span>}
                  </a>
                </article>
              );
            })}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-shop-look]').forEach((root) => {
    const hotspots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-hotspot]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-product-panel]'));

    const closeDetails = (returnFocus = false) => {
      const activeHotspot = hotspots.find((hotspot) => hotspot.getAttribute('aria-expanded') === 'true');
      hotspots.forEach((hotspot) => hotspot.setAttribute('aria-expanded', 'false'));
      panels.forEach((panel) => { panel.hidden = true; });
      if (returnFocus) activeHotspot?.focus();
    };

    hotspots.forEach((hotspot) => {
      hotspot.addEventListener('click', () => {
        const wasOpen = hotspot.getAttribute('aria-expanded') === 'true';
        const panel = root.querySelector<HTMLElement>(`#${hotspot.dataset.target}`);
        closeDetails();
        if (wasOpen || !panel) return;
        hotspot.setAttribute('aria-expanded', 'true');
        panel.hidden = false;
      });
    });

    root.querySelectorAll<HTMLButtonElement>('[data-product-close]').forEach((button) => button.addEventListener('click', () => closeDetails(true)));
    document.addEventListener('click', (event) => { if (event.target instanceof Node && !root.contains(event.target)) closeDetails(); });
    document.addEventListener('keydown', (event) => { if (event.key === 'Escape') closeDetails(true); });
  });
</script>
