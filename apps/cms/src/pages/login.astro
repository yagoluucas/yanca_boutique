---
import { isAuthenticated } from '../lib/auth';

if (isAuthenticated(Astro.request)) return Astro.redirect('/');
const hasError = Astro.url.searchParams.has('error');
const hasConfigError = Astro.url.searchParams.has('config');
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Entrar | CMS Yanca Boutique</title>
    <style>
      :root { font-family: Inter, ui-sans-serif, system-ui, sans-serif; color: #2d2623; background: #f5f0ec; }
      * { box-sizing: border-box; }
      body { margin: 0; min-height: 100vh; display: grid; place-items: center; padding: 24px; }
      main { width: min(100%, 420px); background: white; padding: 32px; border-radius: 20px; box-shadow: 0 18px 60px rgb(45 38 35 / 0.12); }
      h1 { margin: 0 0 8px; font-size: 1.7rem; }
      p { color: #71645e; line-height: 1.5; }
      label { display: grid; gap: 7px; margin-top: 18px; font-weight: 650; }
      input { width: 100%; padding: 12px 14px; border: 1px solid #d8cec8; border-radius: 10px; font: inherit; }
      button { width: 100%; margin-top: 24px; padding: 13px 16px; border: 0; border-radius: 10px; background: #2d2623; color: white; font: inherit; font-weight: 700; cursor: pointer; }
      .error { background: #fff0f0; color: #8a2525; padding: 10px 12px; border-radius: 10px; }
    </style>
  </head>
  <body>
    <main>
      <h1>Yanca Boutique</h1>
      <p>Entre para editar e publicar o conteúdo do site.</p>
      {hasError && <p class="error">E-mail ou senha inválidos.</p>}
      {hasConfigError && <p class="error">O CMS ainda não está configurado no servidor.</p>}
      <form action="/api/login" method="post">
        <label>
          E-mail
          <input type="email" name="email" autocomplete="username" required />
        </label>
        <label>
          Senha
          <input type="password" name="password" autocomplete="current-password" required />
        </label>
        <button type="submit">Entrar</button>
      </form>
    </main>
  </body>
</html>
